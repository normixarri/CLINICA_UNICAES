# ===============================
# CONFIGURACION GENERAL
# ===============================
FRONTEND_URL=http://localhost:3000

# ===============================
# BASE DE DATOS
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=clinica_db

# ===============================
# CORREO
# ===============================
# test:
#   Para piloto/desarrollo. No usa SMTP ni servicios externos.
#   Siempre muestra destino, asunto, enlace, token o codigo en consola.
#
# ethereal:
#   Opcional. Usa una cuenta temporal de Ethereal y requiere conexion a internet.
#
# production:
#   Usa SMTP real. La institucion debe llenar SMTP_HOST, SMTP_PORT,
#   SMTP_SECURE, SMTP_USER, SMTP_PASS y SMTP_FROM.
MAIL_MODE=test

# SMTP real para MAIL_MODE=production.
# Ejemplo:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=correo@institucion.edu.sv
# SMTP_PASS=clave-o-app-password
# SMTP_FROM="Clinica Universitaria" <correo@institucion.edu.sv>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===============================
# SEGURIDAD
# ===============================
# Cambiar en cada instalacion. Puede generarse con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=coloque_aqui_un_secreto_largo_y_aleatorio

# Activar temporalmente para diagnosticar las etapas de creacion de usuarios.
# No imprime contrasenas, tokens ni contenido binario de firma/sello.
DEBUG_USUARIO_CREACION=false
